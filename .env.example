# Clarion environment. Names are vendor neutral on purpose: swap a provider by
# changing *_PROVIDER and its key, never by renaming variables in code.
# Copy to .env. Never commit .env.

# ---- runtime ------------------------------------------------------------
APP_ENV=development            # development | test | production
APP_BASE_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=console             # console | json
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- data (any Postgres 15+ with the pgvector extension) ---------------
DATABASE_URL=postgresql+asyncpg://clarion:clarion@localhost:5432/clarion

# ---- queue and cache (any Redis compatible server) ---------------------
REDIS_URL=redis://localhost:6379/0

# ---- object storage (any S3 compatible store) --------------------------
STORAGE_PROVIDER=local         # local | s3
STORAGE_BUCKET=clarion-media
STORAGE_ENDPOINT_URL=          # e.g. Supabase, R2 or MinIO S3 endpoint
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=./var/media

# ---- language model ------------------------------------------------------
LLM_PROVIDER=fake              # fake | gemini
LLM_API_KEY=
LLM_MODEL=                     # chat and vision model id for the provider
LLM_EMBEDDING_MODEL=           # embedding model id for the provider
LLM_EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=30
LLM_MONTHLY_BUDGET_USD=20

# ---- speech --------------------------------------------------------------
SPEECH_PROVIDER=fake           # fake | <provider name once its adapter exists>
SPEECH_API_KEY=
SPEECH_BASE_URL=

# ---- channels (each channel is optional; leave blank to disable) -------
CHANNEL_TELEGRAM_BOT_TOKEN=
CHANNEL_TELEGRAM_CHAT_ID=      # public channel id, e.g. @clarion_demo
CHANNEL_SMS_PROVIDER=         # textbee
CHANNEL_SMS_API_KEY=
CHANNEL_SMS_SENDER_ID=
CHANNEL_SMS_DEVICE_ID=         # TextBee device id (optional; defaults to your newest device)
CHANNEL_SMS_RECIPIENTS=       # comma separated +234... numbers that agreed to test messages
CHANNEL_X_ACCESS_TOKEN=       # OAuth 2.0 user token with tweet.write
CHANNEL_WHATSAPP_TOKEN=
CHANNEL_WHATSAPP_PHONE_NUMBER_ID=

# ---- security ------------------------------------------------------------
AUTH_JWT_SECRET=change-me-in-every-environment
AUTH_REVIEWER_INVITE_CODE=

# ---- web (Vite exposes only VITE_ prefixed names to the browser) -------
VITE_API_BASE_URL=http://localhost:8000

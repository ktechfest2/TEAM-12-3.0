# Settings for a self hosted Clarion. Copy to the state folder with: clarion.sh init
# Plain KEY=value lines, no spaces around "=". Database, queue and storage settings are not
# listed because the deploy script generates or derives them. See docs/deploy/.

# Public hostname. In Cloudflare, add a proxied A record for it that points at the server.
DOMAIN=

# Reviewers sign in with this code. Choose a long random value.
AUTH_REVIEWER_INVITE_CODE=

# Language model. "fake" runs offline with placeholder answers; use "gemini" for real ones.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_MODEL=
LLM_MONTHLY_BUDGET_USD=20
# Blended price in USD per million tokens for the model above (input and output together); use
# something near its output price so the cap errs on the safe side.
LLM_USD_PER_MILLION_TOKENS=1

# Voice notes. "fake" stores placeholder audio that does not play; use "spitch" for real
# Yoruba, Hausa, Igbo and English voices. Optional SPEECH_VOICES picks a voice per language
# as JSON, for example {"pcm":"<voice>"}; Pidgin uses the English voice until one is set.
SPEECH_PROVIDER=fake
SPEECH_API_KEY=
SPEECH_VOICES=

# Telegram channel (optional). Leave blank to use the built in test channel.
CHANNEL_TELEGRAM_BOT_TOKEN=
CHANNEL_TELEGRAM_CHAT_ID=

# Optional overrides. Left blank, the script generates these once and keeps them.
AUTH_JWT_SECRET=
CHANNEL_TELEGRAM_WEBHOOK_SECRET=

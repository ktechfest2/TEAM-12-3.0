{
  "name": "clarion-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome ci .",
    "fmt": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "types": "openapi-typescript ../../contracts/openapi.json -o src/lib/api/schema.gen.ts && biome format --write src/lib/api/schema.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.0",
    "cobe": "^2.0.1",
    "lucide-react": "^1.76.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
